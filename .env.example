# =========================
# App
# =========================
APP_ENV=development
LOG_FILE_PATH=/var/log/podcast_rag
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# =========================
# GROQ
# =========================
GROQ__API_KEY=your_groq_api_key_here
GROQ__ASK_MODEL=llama3-8b-8192
GROQ__NOTES_MODEL=llama3-70b-8192
GROQ__EVALUATION_MODEL=groq/compound-mini
GROQ__MODEL_VERSION=1
GROQ__TIMEOUT_SECS=30
GROQ__RETRIES=2

# =========================
# Redis
# =========================
REDIS__CACHE_URL=redis://redis:6379/0
REDIS__MIN_POOL_SIZE=5
REDIS__MAX_POOL_SIZE=20
REDIS__SESSION_TTL=7200
REDIS__ARQ_URL=redis://redis:6379/1

# =========================
# Telegram
# =========================
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_BASE_URL=your_webhook_base_url_here
WEBHOOK_PATH=your_webhook_path_here

# =========================
# Qdrant
# =========================
QDRANT__HOST=qdrant
QDRANT__PORT=6333
QDRANT__VECTOR_SIZE=384
QDRANT__CHUNK_SIZE=384
QDRANT__CHUNK_OVERLAP=64

# =========================
# Postgres
# =========================
POSTGRES__USER=postgres
POSTGRES__PASSWORD=your_postgres_password_here
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__DB_NAME=podcast_rag
POSTGRES__MIN_POOL_SIZE=2
POSTGRES__MAX_POOL_SIZE=10

# =========================
# MLflow
# =========================
MLFLOW__TRACKING_URL=http://mlflow:5000
MLFLOW__EXPERIMENT_NAME=podcast-rag

# =========================
# Embeddings
# =========================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# =========================
# Retrieval
# =========================
RETRIEVAL_TOP_K=5

# =========================
# Rate Limits
# =========================
MAX_VIDEOS_PER_USER_PER_DAY=10
MAX_NOTES_PER_VIDEO_PER_MODEL=2

# =========================
# Input Validation
# =========================
MAX_QUESTION_CHARS=500

# =========================
# Notes Generation
# =========================
NOTES_CHUNK_BATCH_SIZE=10
NOTES_MIN_WORDS=500
NOTES_MAX_WORDS=5000